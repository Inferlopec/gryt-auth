# Inferlo identity stack — secrets and settings.
# Copy to .env and fill in before first start. Do not commit .env.

# --- Keycloak admin (master realm) ---
GRYT_KEYCLOAK_ADMIN_USERNAME=admin
# Generate with: openssl rand -base64 24
GRYT_KEYCLOAK_ADMIN_PASSWORD=

# --- Postgres (Keycloak DB) ---
GRYT_AUTH_POSTGRES_DB=keycloak
GRYT_AUTH_POSTGRES_USER=keycloak
# Generate with: openssl rand -base64 24
GRYT_AUTH_POSTGRES_PASSWORD=

# --- Public URLs (Caddy must map these domains) ---
GRYT_KEYCLOAK_HOSTNAME_URL=https://auth.inferlo.xyz
GRYT_KEYCLOAK_HOSTNAME_ADMIN_URL=https://auth.inferlo.xyz
# Realm issuer — must match the realm id in realm/gryt-realm.json ("gryt").
# Do not change once accounts exist: it is the OIDC issuer for every token and
# the audience the Identity Service validates.
GRYT_OIDC_ISSUER=https://auth.inferlo.xyz/realms/gryt
# Issuer (iss) written into issued identity certificates.
GRYT_IDENTITY_ORIGIN=https://id.inferlo.xyz
GRYT_REALM=gryt

# --- Client-facing configuration (Gryt server profile, web client config.js) ---
GRYT_OIDC_CLIENT_ID=gryt-web
GRYT_OIDC_REALM=gryt
GRYT_IDENTITY_URL=https://id.inferlo.xyz
GRYT_AUTH_API=https://auth.inferlo.xyz
# Separate from the host: must match the registered callback route of the web client.
GRYT_AUTH_CALLBACK_URL=https://app.inferlo.xyz

# --- Ports (127.0.0.1 only, not visible externally) ---
GRYT_KEYCLOAK_PORT=18080
GRYT_IDENTITY_PORT=18081

# --- Realm import ---
# 1 = (re)import the realm on startup (DELETES the existing realm and all its users!)
# 0 = skip. Keep 0 in production. For a recovery re-import use scripts/reimport_realm.sh.
GRYT_IMPORT_REALM=0

# --- SMTP (not selected yet; leave empty until then) ---
# The production SMTP service is not chosen. Set all of these together, then
# re-run the realm import (scripts/reimport_realm.sh) to pick them up: the
# values are substituted into realm/gryt-realm.json at import time.
GRYT_SMTP_HOST=
GRYT_SMTP_PORT=
GRYT_SMTP_FROM=
GRYT_SMTP_FROM_NAME=
GRYT_SMTP_REPLY_TO=
GRYT_SMTP_REPLY_TO_NAME=
GRYT_SMTP_USER=
GRYT_SMTP_PASS=

# --- Backups ---
# Where pg-backup writes (default: ./backups beside the compose file).
GRYT_AUTH_BACKUP_DIR=
# Off-host copy command (scripts/backup_offsite.sh). Must take no arguments and
# copy the latest keycloak-*.sql.gz and ca-key-*.tar.gz from ./backups to the
# backup destination. The destination is not selected yet — examples:
#   rsync -a ./backups/ backup-host:/var/backups/inferlo-identity/
#   rcopy to a bucket with `rclone copy ./backups remote:inferlo-identity --min-age 1m`
# Leave empty to skip off-host copies.
BACKUP_OFFSITE_CMD=

# --- Identity service ---
# CA key lifetime (days) and the account-key gate (learn | enforce | off).
GRYT_CERT_LIFETIME_DAYS=30
GRYT_ACCOUNT_KEY_GATE=learn
# Only these addresses may set CF-Connecting-IP for pairing rate limiting.
# Caddy runs with host networking, so 127.0.0.1 is correct for the same-host
# layout; for a dedicated-VM layout use the Caddy VM's private address.
GRYT_PAIRING_TRUSTED_PROXIES=127.0.0.1
# Optional: path (inside the container) to an existing PEM ECDSA P-256 CA key.
# Empty = the key is generated once and stored in the inferlo-identity-data volume.
GRYT_CA_PRIVATE_KEY_FILE=

# --- Device authorization grant (linking a new device from a signed-in one) ---
GRYT_DEVICE_CODE_LIFESPAN=300
GRYT_DEVICE_POLLING_INTERVAL=5

# --- Login hardening overrides (applied by keycloak-security-policy) ---
# Defaults are sane; set only to override.
# GRYT_KC_FAILURE_FACTOR=8
# GRYT_KC_WAIT_INCREMENT_SECONDS=60
# GRYT_KC_MAX_WAIT_SECONDS=900
# GRYT_KC_MAX_DELTA_SECONDS=43200
# GRYT_KC_PASSWORD_POLICY=length(12) and notUsername and notEmail
